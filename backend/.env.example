# YojanaSetu Backend Environment Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development

# AI Assistant Configuration (Setu Sahayak Intelligence Layer)
# Supported LLM_PROVIDER: "gemini", "openai", or "mock"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=30.0

# API Keys (Provide your own key for live production/dev, or leave blank to use intelligent mock fallback)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
